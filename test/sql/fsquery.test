# name: test/sql/fsquery.test
# description: test fsquery extension
# group: [sql]

# Require statement will ensure this test is run with this extension loaded
require fsquery

# Test basic functionality - scan a simple directory
query I
SELECT COUNT(*) > 0 FROM fsquery_scan('.');
----
true

# Test that we can get file paths
query I
SELECT COUNT(*) > 0 FROM fsquery_scan('.') WHERE path LIKE '%.test';
----
true

# Test projection pushdown - select only specific columns
query I
SELECT COUNT(*) > 0 FROM (SELECT path FROM fsquery_scan('.'));
----
true

# Test file type detection
query I
SELECT COUNT(*) > 0 FROM fsquery_scan('.') WHERE is_regular_file = true;
----
true

# Test directory detection
query I
SELECT COUNT(*) > 0 FROM fsquery_scan('.') WHERE is_directory = true;
----
true
